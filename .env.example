# =====================================================================
# Судебный симулятор — секреты.
# Скопируйте файл в .env и подставьте свой ключ:  cp .env.example .env
# .env добавлен в .gitignore и не попадёт в репозиторий.
# =====================================================================

# Ключ доступа к OpenAI-совместимому роутеру.
# Пример для OpenRouter (https://openrouter.ai/keys):
OPENROUTER_API_KEY=sk-or-v1-вставьте-сюда-свой-ключ

# Пример для прямого OpenAI (тогда в config.yaml укажите: api_key_env: "OPENAI_API_KEY"):
# OPENAI_API_KEY=sk-...
