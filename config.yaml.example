# =====================================================================
# Судебный симулятор — конфигурация.
# Скопируйте файл в config.yaml и настройте под себя:
#   cp config.yaml.example config.yaml
# Ключ API хранится НЕ здесь, а в .env (см. .env.example).
# =====================================================================

# OpenAI-совместимый роутер: OpenRouter, LiteLLM, self-hosted vLLM, прямой OpenAI.
api_base_url: "https://openrouter.ai/api/v1"

# Имя переменной окружения, в которой лежит ключ API (само значение — в .env).
api_key_env: "OPENROUTER_API_KEY"

# Модели по ролям. Можно назначить одну модель всем ролям или разные.
# Примеры имён моделей для OpenRouter: "openai/gpt-4o-mini",
# "anthropic/claude-3.5-sonnet", "google/gemini-2.0-flash-001".
model_claimant_lawyer: "openai/gpt-4o-mini"
model_defendant_lawyer: "openai/gpt-4o-mini"
model_judge: "openai/gpt-4o"

# Юрисдикция — подставляется в системные промпты агентов.
# Примеры: "Российская Федерация, гражданское право", "РФ, арбитражный процесс".
jurisdiction: "Российская Федерация, гражданское право"

# Максимум раундов прений (реплика заявителя + реплика ответчика + проверка судьи).
max_rounds: 3

# Лимит токенов на контекст дела; при превышении материалы суммаризируются LLM.
max_context_tokens: 12000

# Дополнительные параметры LLM-запросов — передаются роутеру «как есть».
#   max_tokens — жёсткий предел длины ответа модели;
#   reasoning  — управление «размышлениями» reasoning-моделей (например GLM):
#                {"effort": "low"} заметно ускоряет ответы таких моделей.
# Пример (раскомментируйте при необходимости):
# llm_params:
#   max_tokens: 2500
#   reasoning: {"effort": "low"}

# MCP-сервер актуальных норм права (pravo.gov.ru) — см. src/legal_tools.py.
# Требует установленного пакета pravo-mcp (ставится из requirements.txt).
# enabled: false — полностью отключить поиск норм (агенты будут помечать
# ссылки как «требует проверки»).
# legal_mcp:
#   enabled: true
#   limit: 3
#   command:  # по умолчанию — python вашего venv + pravo_mcp.server (stdio)
#     - ".venv/Scripts/python.exe"
#     - "-X"
#     - "utf8"
#     - "-m"
#     - "pravo_mcp.server"

# Правовое исследование (Evidence Pack). Веб-поиск дополняет официальные API
# (pravo.gov.ru, vsrf.ru) практикой нижестоящих судов через поисковую модель
# роутера. ВАЖНО: search_model обязан поддерживать веб-поиск (Perplexity Sonar
# и аналоги); обычная chat-модель источники не найдёт. Результаты веб-поиска
# помечаются «требует сверки» и проходят проверку linter-ом ссылок.
# legal_research:
#   web_search: true                      # false — отключить веб-поиск (экономия/скорость)
#   search_model: "perplexity/sonar-pro-search"  # алиас поисковой модели роутера
